---
interface Props {
  name: string
  affiliation: string
  image: string
  email?: string
  linkedin?: string
}

const { name, affiliation, image, email, linkedin } = Astro.props

import { HugeiconsIcon } from "@hugeicons/react"
import { Linkedin02Icon, Mail01Icon } from "@hugeicons/core-free-icons"
---

<article
  class="grid grid-cols-1 gap-4 rounded-xl border border-red-800 bg-red-900 p-4 shadow-[inset_0_0_10px_rgba(0,0,0,.1)] md:gap-10 md:p-6 lg:grid-cols-[.3fr_.7fr]"
>
  <div class="flex h-full w-full flex-col justify-between">
    <div class="h-100 w-full lg:h-62">
      <img src={image} alt={name} class="h-full w-full rounded-lg object-cover" />
    </div>

    <ul class="flex items-center gap-4">
      {
        email && (
          <li>
            <a class="flex h-10.5 w-10.5 cursor-pointer items-center justify-center rounded-full border border-red-300/60 bg-red-300/30 transition-transform hover:-translate-y-1">
              <HugeiconsIcon icon={Mail01Icon} className="h-5 w-5 text-red-50" fill="currentColor" fillOpacity={0.3} />
            </a>
          </li>
        )
      }

      {
        linkedin && (
          <li>
            <a class="flex h-10.5 w-10.5 cursor-pointer items-center justify-center rounded-full border border-red-300/60 bg-red-300/30 transition-transform hover:-translate-y-1">
              <HugeiconsIcon icon={Linkedin02Icon} className="h-5 w-5 text-red-50" fill="currentColor" fillOpacity={0.3} />
            </a>
          </li>
        )
      }
    </ul>
  </div>

  <div class="flex flex-col">
    <h3 class="text-xl font-medium text-red-50 md:text-2xl">{name}</h3>
    <h4 class="mb-6 text-sm font-medium text-red-50/70">{affiliation}</h4>

    <div class="space-y-4 text-red-50/70">
      <slot />
    </div>
  </div>
</article>
