---
import SectionTitleAlt from "@/components/shared/section-title-alt.astro"

import SpeakerCard from "./speaker-card.astro"
---

<section class="flex w-full justify-center overflow-hidden bg-white px-4 xl:rounded-br-4xl xl:rounded-bl-4xl">
  <div class="flex w-full max-w-7xl flex-1 flex-col py-16 lg:py-26">
    <SectionTitleAlt title="Invited Speakers" subtitle="SPEAKERS" />

    <div class="grid grid-cols-1 md:grid-cols-[.55fr_1fr] md:gap-10 lg:mb-16 lg:gap-20">
      <div class="col-start-2 flex flex-col gap-4 text-slate-600">
        <SpeakerCard
          name="Dr. Ikrimah Nafilata, S.K.M., M.Kes (Epid)"
          affiliation="STIKES Guna Bangsa Yogyakarta, Indonesia"
          image="/assets/images/speakers/ikrimah-nafilata.jpeg"
        >
          <p>
            Dr. Ikrimah Nafilata is an expert in epidemiology and public health at STIKES Guna Bangsa Yogyakarta, with extensive experience in health
            management and epidemiological research.
          </p>
        </SpeakerCard>

        <SpeakerCard
          name="Anita Nur Mayani, S.Tr.Rad., M.T."
          affiliation="STIKES Guna Bangsa Yogyakarta, Indonesia"
          image="/assets/images/speakers/anita-nur-mayani.jpg"
        >
          <p>
            Anita Nur Mayani specializes in radiological technology and medical imaging at STIKES Guna Bangsa Yogyakarta, with significant
            contributions to diagnostic imaging research.
          </p>
        </SpeakerCard>

        <SpeakerCard
          name="Associate Professor Ts. Dr. Wan Ismahanisa"
          affiliation="Universiti Teknologi MARA (UiTM), Malaysia"
          image="/assets/images/speakers/wan.webp"
        >
          <p>
            Assoc. Prof. Ts. Dr. Wan Ismahanisa Ismail is an Associate Professor at Universiti Teknologi MARA specializing in public health and health
            sciences, recognized globally for her academic leadership, research contributions, and extensive international collaborations.
          </p>
        </SpeakerCard>

        <SpeakerCard
          name="Siriyaphon Jensariga"
          affiliation="Boromarajonani College of Nursing NSPRNW, Thailand"
          image="/assets/images/speakers/sriyaphon.webp"
        >
          <p></p>
        </SpeakerCard>

        <SpeakerCard
          name="Dr. Mohd Nazmi Che Nordin"
          affiliation="Department of Radiography and Medical Imaging at Fatima College of Health Sciences, Al Ain Campus, Abu Dhabi, United Arab Emirates"
          image="/assets/images/speakers/nazmi.webp"
        >
          <p>
            Dr. Mohd Nazmi Che Nordin is an Assistant Professor of Radiography and Medical Imaging at Fatima College of Health Sciences, UAE. Holding
            a PhD from The Chinese University of Hong Kong, he specializes in advanced medical imaging, MRI, and molecular imaging. An active
            researcher and international speaker, he is dedicated to advancing health sciences through education and global collaboration.
          </p>
        </SpeakerCard>
      </div>
    </div>
  </div>
</section>
