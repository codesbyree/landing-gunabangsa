---
import { cn } from "@/lib/utils"
import { HugeiconsIcon } from "@hugeicons/react"
import { DownloadIcon, AlertIcon } from "@hugeicons/core-free-icons"

import { buttonVariants } from "@/components/ui/button"
import { Alert, AlertDescription, AlertTitle } from "@/components/ui/alert"
import SectionTitleAlt from "@/components/shared/section-title-alt.astro"
import PreparationCardRenderer from "./preparation-card-renderer"
---

<section class="flex w-full justify-center overflow-hidden bg-red-50 px-4">
  <div class="flex w-full max-w-6xl flex-1 flex-col py-26 2xl:max-w-7xl">
    <SectionTitleAlt
      title="Instructions for Presenters"
      subtitle="PRESENTATION"
    />

    <div
      class="relative grid grid-cols-1 gap-4 md:grid-cols-[.55fr_1fr] md:gap-10 lg:gap-20"
    >
      <div></div>

      <div class="flex flex-col gap-4 text-slate-600">
        <Alert
          className="border-amber-200 bg-amber-50 text-amber-900 dark:border-amber-900 dark:bg-amber-950 dark:text-amber-50"
        >
          <HugeiconsIcon
            icon={AlertIcon}
            size={16}
            className="shrink-0 text-red-400"
            color="currentColor"
          />
          <AlertTitle>Important Notice</AlertTitle>
          <AlertDescription>
            <p>
              All accepted papers are required to give an oral presentation.
            </p>

            <ul class="list-disc">
              <li>
                The duration of each presentation is 15 minutes, including the
                Q&A session.
              </li>
              <li>
                An LCD projector and computer (Windows 10 or 11, MS PowerPoint,
                and Adobe Acrobat Reader) will be available in each session
                room.
              </li>
              <li>Double-blind peer review is mandatory for all tracks.</li>
              <li>
                You will have 10 minutes for your presentation and 5 minutes for
                audience questions and discussion.
              </li>
            </ul>
          </AlertDescription>
        </Alert>

        <PreparationCardRenderer />

        <p>Get the paper template here:</p>

        <div class="flex gap-2">
          <a href="" class={cn(buttonVariants({ variant: "default" }))}
            >Download template Docs
            <HugeiconsIcon
              icon={DownloadIcon}
              size={16}
              color="currentcolor"
              className="shrink-0"
            />
          </a>
          <a href="" class={cn(buttonVariants({ variant: "default" }))}
            >Download template LaTex
            <HugeiconsIcon
              icon={DownloadIcon}
              size={16}
              color="currentcolor"
              className="shrink-0"
            />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
