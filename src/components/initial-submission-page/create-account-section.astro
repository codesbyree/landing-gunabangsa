---
import SectionTitle from "@/components/shared/section-title.astro"
import { Separator } from "../ui/separator"
---

<section class="flex w-full justify-center bg-white px-4">
  <div class="flex w-full max-w-6xl flex-1 flex-col py-16 lg:py-26 2xl:max-w-7xl">
    <SectionTitle
      title="Create an IGERS Account"
      subtitle="REGISTER"
      description="You are required to create an IGERS account to submit your manuscript."
    />

    <div class="grid w-full grid-cols-1 items-start gap-4 md:grid-cols-2 md:gap-10 lg:mb-16">
      <div class="flex flex-col gap-8 md:col-start-2">
        <article class="flex flex-col gap-4">
          <h2 class="font-semibold text-red-900">1. Open IGERS</h2>
          <p class="text-gray-600">
            Go to <a href="https://igers.org/register" class="text-blue-600" target="_blank">igers.org/register.</a> Or click "Register Now" button on the
            top-right corner of this website.
          </p>
        </article>
        <Separator />

        <article class="flex flex-col gap-4">
          <h2 class="font-semibold text-red-900">2. Fill out the form</h2>
          <p class="text-gray-600">Fill out the required informations, then click continue.</p>
          <img src="/assets/images/tutorial/register.webp" alt="" class="w-full" />
        </article>
        <Separator />

        <article class="flex flex-col gap-4">
          <h2 class="font-semibold text-red-900">3. Verify your email</h2>
          <p class="text-gray-600">
            Check your inbox for the verification email. If it's missing or expired, follow the "My verification link is expired, what should I do?"
            tutorial to request a new one.
          </p>
        </article>
        <Separator />

        <article class="flex flex-col gap-4">
          <h2 class="font-semibold text-red-900">4. You successfully created your account.</h2>
        </article>
      </div>
    </div>
  </div>
</section>
