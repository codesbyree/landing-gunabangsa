---
import { AspectRatio } from "../ui/aspect-ratio"
import SectionTitle from "@/components/shared/section-title.astro"
---

<section class="flex w-full justify-center bg-white px-4">
  <div class="flex w-full max-w-6xl flex-1 flex-col py-16 lg:py-26 2xl:max-w-7xl">
    <SectionTitle
      title="Create an IGERS Account"
      subtitle="ACCOUNT"
      description="You are required to create an IGERS account to submit your manuscript."
    />

    <div class="grid w-full grid-cols-1 gap-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
      {
        [
          `Go to igers.org/register. Or click "Register Now" button on the top-right corner of this website.`,
          "In the register page, fill out all the required fields, then click Continue.",
          "After creating an account, you will be prompted to verify your email.",
          `Check your inbox for the verification email. If it's missing or expired, follow the "My verification link is expired, what should I do?" tutorial to request a new one.`,
          "After verifying your email address, you will be automatically redirected to your dashboard.",
        ].map((step, index) => (
          <AspectRatio ratio={3 / 4}>
            <div class="h-full w-full overflow-hidden rounded-2xl shadow-sm shadow-red-950/50 transition-all hover:-translate-y-1 hover:opacity-90">
              <div class="relative flex h-full w-full flex-col justify-end gap-2 rounded-2xl border border-red-950 bg-red-900 p-6 shadow-[inset_0_0_10px_rgba(0,0,0,1)]">
                <p class="absolute top-6 left-6 text-7xl font-black text-white/30">{index + 1}</p>
                <p class="font-medium text-white">{step}</p>
              </div>
            </div>
          </AspectRatio>
        ))
      }
    </div>
  </div>
</section>
