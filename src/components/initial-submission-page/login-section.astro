---
import SectionTitle from "@/components/shared/section-title.astro"
import { Separator } from "../ui/separator"
---

<section class="flex w-full justify-center bg-red-50 px-4">
  <div class="flex w-full max-w-7xl flex-1 flex-col py-16 lg:py-26">
    <SectionTitle
      title="How to log in into your account"
      subtitle="LOGIN"
      description="You are required to have an IGERS account to submit your manuscript."
    />

    <div class="grid w-full grid-cols-1 items-start gap-4 leading-8 md:grid-cols-2 md:gap-10 lg:mb-16">
      <div class="col-start-2 flex flex-col gap-8 leading-8">
        <article class="flex flex-col gap-4">
          <h2 class="rounded-tl-full rounded-bl-full bg-red-100/50">
            <span class="mr-3 inline-block rounded-full bg-red-900 px-4 py-2 text-xs text-red-50">01</span>
            <span class="font-semibold text-red-900">Open IGERS</span>
          </h2>

          <p class="text-gray-600">
            Navigate to <a href="https://igers.org/login">igers.org/login</a>
          </p>
        </article>

        <article class="flex flex-col gap-4">
          <h2 class="rounded-tl-full rounded-bl-full bg-red-100/50">
            <span class="mr-3 inline-block rounded-full bg-red-900 px-4 py-2 text-xs text-red-50">02</span>
            <span class="font-semibold text-red-900">Fill out the form</span>
          </h2>

          <p class="text-gray-600">Fill out the required informations</p>
          <img src="/assets/images/tutorial/login.webp" alt="" class="w-full rounded-md" />
        </article>

        <article class="flex flex-col gap-4">
          <h2 class="rounded-tl-full rounded-bl-full bg-red-100/50">
            <span class="mr-3 inline-block rounded-full bg-red-900 px-4 py-2 text-xs text-red-50">03</span>
            <span class="font-semibold text-red-900">Click the login button</span>
          </h2>
        </article>
      </div>
    </div>
  </div>
</section>
