---
interface Props {
  title: string
  image: string
}

const { title, image } = Astro.props
---

<article>
  <h3 class="text-xl font-medium text-red-900 md:text-2xl">{title}</h3>

  <img src={image} alt="" class="my-5 h-24" />

  <div class="space-y-4 text-gray-600">
    <slot />
  </div>
</article>
