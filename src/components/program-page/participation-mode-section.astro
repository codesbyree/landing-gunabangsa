---
import SectionTitle from "@/components/shared/section-title.astro"
import PCRenderer from "./pc-renderer"
---

<section class="flex w-full justify-center bg-white px-4 xl:rounded-br-4xl xl:rounded-bl-4xl">
  <div class="flex w-full max-w-7xl flex-1 flex-col py-16 lg:py-26">
    <SectionTitle
      title="Mode of Participations"
      subtitle="PARTICIPATIONS"
      description="Explore the flexible ways you can join the conference—whether presenting your research onsite in Istanbul or participating virtually from anywhere in the world."
    />

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-10">
      <div></div>

      <PCRenderer />
    </div>
  </div>
</section>
