    role: "SPONSOR",
    logoUrl: "/assets/images/macro.png",
    logoAlt: "PT. Macro Inti Guna Logo",
  },
]
---

<section data-app-sponsors class="relative flex w-full justify-center overflow-hidden bg-white px-4 xl:rounded-br-4xl xl:rounded-bl-4xl">
  <div class="absolute top-[-50%] left-0 z-1 w-full">
    <AspectRatio ratio={1 / 1}>
      <div class="h-full w-full rounded-br-full rounded-bl-full opacity-50">
        <img src="/assets/images/round-pattern-1-xl.png" alt="" class="h-full w-full" />
      </div>
    </AspectRatio>
  </div>

  <div class="w-fullmax-w-7xl relative z-10 flex max-w-7xl flex-1 flex-col py-16 lg:py-26">
    <SectionTitle
      title="Conference Organizers and Partners"
      subtitle="NETWORK"
      description="Meet the prestigious organizations and partners dedicated to advancing the future of biomedical engineering and modern healthcare."
    />

    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-4">
        <h2 class="text-lg font-medium text-red-800 md:text-xl">Host</h2>

        <div class="mb-4 grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
          {
            host.map((item) => (
              <div data-animate-up class="relative flex flex-col items-center gap-5 overflow-hidden rounded-2xl border border-border bg-card/50 p-6">
                <div class="relative z-20 h-24 w-full">
                  <img src={item.logoUrl} alt={item.logoAlt || item.name} class="h-full w-full object-contain mix-blend-multiply" />
                </div>

                <div class="relative z-20 flex flex-col justify-between gap-4 text-center">
                  <div>
                    <h4 class="font-heading text-base font-medium">{item.name}</h4>
                    <p class="text-sm text-muted-foreground">{item.location}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <h2 class="text-lg font-medium text-red-800 md:text-xl">Co-Host</h2>

        <div class="mb-4 grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
          {
            cohosts.map((item) => (
              <div data-animate-up class="relative flex flex-col items-center gap-5 overflow-hidden rounded-2xl border border-border bg-card/50 p-6">
                <div class="relative z-20 h-24 w-full">
                  <img src={item.logoUrl} alt={item.logoAlt || item.name} class="h-full w-full object-contain mix-blend-multiply" />
                </div>

                <div class="relative z-20 flex flex-col justify-between gap-4 text-center">
                  <div>
                    <h4 class="font-heading text-base font-medium">{item.name}</h4>
                    <p class="text-sm text-muted-foreground">{item.location}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <h2 class="text-lg font-medium text-red-800 md:text-xl">Sponsors</h2>

        <div class="mb-4 grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
          {
            sponsors.map((item) => (
              <div data-animate-up class="relative flex flex-col items-center gap-5 overflow-hidden rounded-2xl border border-border bg-card/50 p-6">
                <div class="relative z-20 h-16 w-full">
                  <img src={item.logoUrl} alt={item.logoAlt || item.name} class="h-full w-full object-contain mix-blend-multiply" />
                </div>

                <div class="relative z-20 flex flex-col justify-between gap-4 text-center">
                  <div>
                    <h4 class="font-heading text-base font-medium">{item.name}</h4>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, SplitText } from "@/lib/gsap"

  function initAnimation() {
    const container = document.querySelector("[data-app-sponsors]")
    if (!container) return

    const ctx = gsap.context(() => {
      const mm = gsap.matchMedia()

      mm.add("(min-width: 1280px)", () => {
        const titleEl = container.querySelector("[data-split-title]")
        const bodyEls = container.querySelectorAll("[data-split-body]")

        if (!titleEl) return

        const splitTitle = new SplitText(titleEl, {
          type: "lines,words",
          linesClass: "overflow-hidden",
        })

        const splitBodyInstances: SplitText[] = []
        const bodyLines: Element[] = []

        bodyEls.forEach((body) => {
          const split = new SplitText(body, {
            type: "lines",
            linesClass: "overflow-hidden",
          })
          splitBodyInstances.push(split)
          bodyLines.push(...split.lines)
        })

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: container,
            start: "top 80%",
            toggleActions: "play none none none",
          },
          defaults: {
            duration: 0.5,
            ease: "power3.out",
          },
        })

        tl.from(splitTitle.words, {
          yPercent: 100,
          opacity: 0,
          stagger: 0.06,
          filter: "blur(10px)",
        })
          .from(
            bodyLines,
            {
              yPercent: 100,
              opacity: 0,
              stagger: 0.06,
              filter: "blur(10px)",
            },
            "-=0.6"
          )
          .from("[data-animate-up]", { y: 30, opacity: 0, filter: "blur(10px)", stagger: 0.2 }, 0.8)

        let resizeTimer: ReturnType<typeof setTimeout>
        const handleResize = () => {
          clearTimeout(resizeTimer)
          resizeTimer = setTimeout(() => {
            ScrollTrigger.refresh()
          }, 200)
        }

        window.addEventListener("resize", handleResize)

        return () => {
          window.removeEventListener("resize", handleResize)
          splitTitle.revert()
          splitBodyInstances.forEach((instance) => instance.revert())
        }
      })
    }, container)

    return ctx
  }

  initAnimation()
</script>
