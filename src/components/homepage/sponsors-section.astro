---
import SectionTitle from "@/components/shared/section-title.astro"
import { AspectRatio } from "../ui/aspect-ratio"

type Role = "HOST" | "CO-HOST" | "SPONSOR" | "PARTNER"

interface OrganizerItem {
  name: string
  location: string
  role: Role
  logoUrl: string
  logoAlt?: string
}

const host: OrganizerItem[] = [
  {
    name: "STIKES Guna Bangsa Yogyakarta",
    location: "Indonesia",
    role: "HOST",
    logoUrl: "/assets/images/stikes-gb.png",
    logoAlt: "STIKES Guna Bangsa Yogyakarta Logo",
  },
]

const cohosts: OrganizerItem[] = [
  {
    name: "Boromarajonani College of Nursing Sawanpracharak Nakhon Sawan",
    location: "Nakhon Sawan, Thailand",
    role: "CO-HOST",
    logoUrl: "/assets/images/co-host.png",
    logoAlt: "Boromarajonani College of Nursing Logo",
  },
  {
    name: "Universitas Awal Bros",
    location: "Indonesia",
    role: "CO-HOST",
    logoUrl: "/assets/images/co-host-1.png",
    logoAlt: "Universitas Awal Bros Logo",
  },
  {
    name: "Institut Kesehatan Rajawali",
    location: "Indonesia",
    role: "CO-HOST",
    logoUrl: "/assets/images/co-host-2.jpg",
    logoAlt: "Institut Kesehatan Rajawali Logo",
  },
  {
    name: "STIKES Pemkan Jombang",
    location: "Indonesia",
    role: "CO-HOST",
    logoUrl: "/assets/images/co-host-3.png",
    logoAlt: "STIKES Pemkan Jombang Logo",
  },
]

const sponsors: OrganizerItem[] = [
  {
    name: "PT. Mertha Jaya Medika",
    location: "Indonesia",
    role: "SPONSOR",
    logoUrl: "/assets/images/mertha.jpeg",
    logoAlt: "PT. Mertha Jaya Medika Logo",
  },
  {
    name: "PT. BTL Indonesia Rukan Permata Senayan",
    location: "Indonesia",
    role: "SPONSOR",
    logoUrl: "/assets/images/btl.jpeg",
    logoAlt: "PT. BTL Indonesia Logo",
  },
  {
    name: "PT. Alfa Medica Bersaudara",
    location: "Indonesia",
    role: "SPONSOR",
    logoUrl: "/assets/images/alfa.jpeg",
    logoAlt: "PT. Alfa Medica Bersaudara Logo",
  },
  {
    name: "PT. Macro Inti Guna",
