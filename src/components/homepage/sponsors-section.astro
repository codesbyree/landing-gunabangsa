---
import SectionTitle from "@/components/shared/section-title.astro"
import { AspectRatio } from "../ui/aspect-ratio"

type Role = "HOST" | "CO-HOST" | "SPONSOR" | "PARTNER"

interface OrganizerItem {
  name: string
  location: string
  role: Role
  logoUrl: string
  logoAlt?: string
}

const host: OrganizerItem[] = [
  {
    name: "STIKES Guna Bangsa Yogyakarta",
    location: "Indonesia",
    role: "HOST",
    logoUrl: "/assets/images/stikes-gb.png",
    logoAlt: "STIKES Guna Bangsa Yogyakarta Logo",
  },
]

const cohosts: OrganizerItem[] = [
  {
    name: "Boromarajonani College of Nursing Sawanpracharak Nakhon Sawan",
    location: "Nakhon Sawan, Thailand",
    role: "CO-HOST",
    logoUrl: "/assets/images/co-host.png",
    logoAlt: "Boromarajonani College of Nursing Logo",
  },
  {
    name: "Universitas Awal Bros",
    location: "Indonesia",
    role: "CO-HOST",
    logoUrl: "/assets/images/co-host-1.png",
    logoAlt: "Universitas Awal Bros Logo",
  },
  {
    name: "Institut Kesehatan Rajawali",
    location: "Indonesia",
    role: "CO-HOST",
    logoUrl: "/assets/images/co-host-2.jpg",
    logoAlt: "Institut Kesehatan Rajawali Logo",
  },
  {
    name: "STIKES Pemkan Jombang",
    location: "Indonesia",
    role: "CO-HOST",
    logoUrl: "/assets/images/co-host-3.png",
    logoAlt: "STIKES Pemkan Jombang Logo",
  },
]

const sponsors: OrganizerItem[] = [
  {
    name: "PT. Mertha Jaya Medika",
    location: "Indonesia",
    role: "SPONSOR",
    logoUrl: "/assets/images/mertha.jpeg",
    logoAlt: "PT. Mertha Jaya Medika Logo",
  },
  {
    name: "PT. BTL Indonesia Rukan Permata Senayan",
    location: "Indonesia",
    role: "SPONSOR",
    logoUrl: "/assets/images/btl.jpeg",
    logoAlt: "PT. BTL Indonesia Logo",
  },
  {
    name: "PT. Alfa Medica Bersaudara",
    location: "Indonesia",
    role: "SPONSOR",
    logoUrl: "/assets/images/alfa.jpeg",
    logoAlt: "PT. Alfa Medica Bersaudara Logo",
  },
  {
    name: "PT. Macro Inti Guna",
    location: "Indonesia",
    role: "SPONSOR",
    logoUrl: "/assets/images/macro.png",
    logoAlt: "PT. Macro Inti Guna Logo",
  },
]
---

<section class="relative flex w-full justify-center overflow-hidden bg-white px-4 xl:rounded-br-4xl xl:rounded-bl-4xl">
  <div class="absolute top-[-50%] left-0 z-1 w-full">
    <AspectRatio ratio={1 / 1}>
      <div class="h-full w-full rounded-br-full rounded-bl-full opacity-50">
        <img src="/assets/images/round-pattern-1-xl.png" alt="" class="h-full w-full" />
      </div>
    </AspectRatio>
  </div>

  <div class="relative z-10 flex w-full max-w-6xl flex-1 flex-col py-26 2xl:max-w-7xl">
    <SectionTitle
      title="Conference Organizers and Partners"
      subtitle="NETWORK"
      description="Meet the prestigious organizations and partners dedicated to advancing the future of biomedical engineering and modern healthcare."
    />

    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-4">
        <h2 class="text-lg font-medium text-red-800 md:text-xl">Host</h2>

        <div class="mb-4 grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
          {
            host.map((item) => (
              <div class="relative flex flex-col items-center gap-5 overflow-hidden rounded-2xl border border-border bg-card/50 p-6">
                <div class="relative z-20 h-24 w-full">
                  <img src={item.logoUrl} alt={item.logoAlt || item.name} class="h-full w-full object-contain mix-blend-multiply" />
                </div>

                <div class="relative z-20 flex flex-col justify-between gap-4 text-center">
                  <div>
                    <h4 class="font-heading text-base font-medium">{item.name}</h4>
                    <p class="text-sm text-muted-foreground">{item.location}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <h2 class="text-lg font-medium text-red-800 md:text-xl">Co-Host</h2>

        <div class="mb-4 grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
          {
            cohosts.map((item) => (
              <div class="relative flex flex-col items-center gap-5 overflow-hidden rounded-2xl border border-border bg-card/50 p-6">
                <div class="relative z-20 h-24 w-full">
                  <img src={item.logoUrl} alt={item.logoAlt || item.name} class="h-full w-full object-contain mix-blend-multiply" />
                </div>

                <div class="relative z-20 flex flex-col justify-between gap-4 text-center">
                  <div>
                    <h4 class="font-heading text-base font-medium">{item.name}</h4>
                    <p class="text-sm text-muted-foreground">{item.location}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <h2 class="text-lg font-medium text-red-800 md:text-xl">Sponsors</h2>

        <div class="mb-4 grid grid-cols-1 gap-2 md:grid-cols-2 lg:grid-cols-3">
          {
            sponsors.map((item) => (
              <div class="relative flex flex-col items-center gap-5 overflow-hidden rounded-2xl border border-border bg-card/50 p-6">
                <div class="relative z-20 h-16 w-full">
                  <img src={item.logoUrl} alt={item.logoAlt || item.name} class="h-full w-full object-contain mix-blend-multiply" />
                </div>

                <div class="relative z-20 flex flex-col justify-between gap-4 text-center">
                  <div>
                    <h4 class="font-heading text-base font-medium">{item.name}</h4>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
