---
import SectionTitle from "@/components/shared/section-title.astro"
import TimelineCardRenderer from "./timeline-card-renderer"
---

<section data-container class="relative flex w-full justify-center overflow-hidden bg-red-50 px-4">
  <div class="w-fullmax-w-7xl relative z-10 flex max-w-7xl flex-1 flex-col py-16 lg:py-26">
    <SectionTitle
      title="Pioneers of the Health Frontier"
      subtitle="TIMELINE"
      description="Navigate through a world-class lineup of sessions led by the architects of tomorrow's medicine and global healthcare policy."
    />

    <div data-animate-up>
      <TimelineCardRenderer client:load />
    </div>
  </div>
</section>
