---
import SectionTitleAlt from "@/components/shared/section-title-alt.astro"
import PreparationCardRenderer from "./preparation-card-renderer"
---

<section class="flex w-full justify-center overflow-hidden bg-red-50 px-4">
  <div class="flex w-full max-w-6xl flex-1 flex-col py-26 2xl:max-w-7xl">
    <SectionTitleAlt title="Presentation Instructions" subtitle="PREPARATION" />

    <div
      class="relative grid grid-cols-1 gap-4 md:grid-cols-[.55fr_1fr] md:gap-10 lg:gap-20"
    >
      <div></div>

      <div class="flex flex-col gap-4 text-slate-600">
        <p>
          All accepted papers are required to give an oral presentation. The
          duration of each presentation is 15 minutes, including the Q&A
          session. You will have 10 minutes for your presentation and 5 minutes
          for audience questions and discussion.
        </p>

        <p>
          An LCD projector and computer (Windows 7, MS PowerPoint, and Adobe
          Acrobat Reader) will be available in each session room for
          presentations.
        </p>

        <PreparationCardRenderer />
      </div>
    </div>
  </div>
</section>
