---
import SectionTitleAlt from "@/components/shared/section-title-alt.astro"
import PreparationCardRenderer from "./preparation-card-renderer"
---

<section class="flex w-full justify-center overflow-hidden bg-red-50 px-4 xl:rounded-br-4xl xl:rounded-bl-4xl">
  <div class="flex w-full max-w-7xl flex-1 flex-col py-16 lg:py-26">
    <SectionTitleAlt title="Revising Your Manuscript" subtitle="PREPARATION" />

    <div class="relative grid grid-cols-1 gap-4 md:grid-cols-[.55fr_1fr] md:gap-10 lg:gap-20">
      <div></div>

      <div class="flex flex-col gap-10 text-slate-700">
        <p class="leading-8">
          All manuscripts identified as requiring revision will undergo a subsequent review process. Authors are expected to prepare a clean Revised
          Manuscript and a separate Response to Reviewers document, clearly outlining how each reviewer’s comment has been addressed.
        </p>

        <PreparationCardRenderer />
      </div>
    </div>
  </div>
</section>
