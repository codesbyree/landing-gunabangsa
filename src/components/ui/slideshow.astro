---
import { Image } from "astro:assets"

export interface Props {
  data: ImageMetadata[]
}

const { data } = Astro.props
---

<div class="relative h-dvh w-dvw overflow-hidden bg-black" data-app-carousel>
  {
    data.map((src, index) => (
      <div class="absolute inset-0 h-full w-full opacity-0 will-change-[opacity]" data-carousel-slide>
        <Image src={src} alt={`Slide ${index + 1}`} loading={index === 0 ? "eager" : "lazy"} class="block h-full w-full object-cover" />
      </div>
    ))
  }
</div>

<script>
  import { gsap } from "@/lib/gsap"

  function initCarousels() {
    const carousel = document.querySelector("[data-app-carousel]")
    if (!carousel) return

    const ctx = gsap.context(() => {
      const slides = Array.from(carousel.querySelectorAll("[data-carousel-slide]")) as HTMLElement[]
      const totalItems = slides.length

      if (totalItems === 0) return
      if (totalItems === 1) {
        gsap.set(slides[0], { opacity: 1 })
        return
      }

      let currentIndex = 0
      const displayDuration = 5
      const transitionDuration = 1

      gsap.set(slides, { opacity: 0 })
      gsap.set(slides[0], { opacity: 1 })

      function showNextSlide() {
        const nextIndex = (currentIndex + 1) % totalItems

        gsap.to(slides[currentIndex], {
          opacity: 0,
          duration: transitionDuration,
          ease: "power2.inOut",
        })

        gsap.to(slides[nextIndex], {
          opacity: 1,
          duration: transitionDuration,
          ease: "power2.inOut",
        })

        currentIndex = nextIndex
      }

      function startLoop() {
        gsap.delayedCall(displayDuration, () => {
          showNextSlide()
          startLoop()
        })
      }

      startLoop()
    }, carousel)

    return ctx
  }

  initCarousels()
</script>
