---
import { cn } from "@/lib/utils"
import { HugeiconsIcon } from "@hugeicons/react"
import { UserAdd02Icon } from "@hugeicons/core-free-icons"

import { buttonVariants } from "@/components/ui/button"
import DesktopNavigation from "./desktop-navigation"
import MobileNavigation from "./mobile-navigation"
---

<div data-app-navigation class="fixed top-0 left-0 z-1000 flex w-full justify-center bg-white shadow-md">
  <div class="flex w-full items-center justify-between gap-4 p-1 px-4 lg:p-2 lg:px-10">
    <a href="/">
      <img src="/assets/images/conference-logo-red.png" alt="logo" class="h-8 md:h-10" />
    </a>

    <div class="hidden lg:block">
      <DesktopNavigation client:load />
    </div>
    <div class="block lg:hidden">
      <MobileNavigation client:load />
    </div>

    <a href="https://igers.org/register" target="_blank" class={cn(buttonVariants({ variant: "default" }), "hidden lg:flex")}>
      Register now <HugeiconsIcon icon={UserAdd02Icon} size={16} color="currentColor" />
    </a>
  </div>
</div>
