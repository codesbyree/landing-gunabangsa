---
import { Image } from "astro:assets"

interface Props {
  pageName: string
  coverImageUrl: ImageMetadata
}

const { pageName, coverImageUrl } = Astro.props
---

<div class="relative h-60 w-full overflow-hidden bg-red-950 lg:h-100">
  <div class="absolute inset-0 z-50 flex flex-col items-center justify-center gap-2 text-white opacity-70">
    <p class="text-2xl lg:text-4xl">{pageName}</p>

    <div class="flex items-center gap-2 text-xs lg:text-sm">
      <a href="/">Home</a> / <p class="uppercase">
        {pageName}
      </p>
    </div>
  </div>

  <div class="absolute inset-0 z-20 bg-linear-to-tl from-orange-800 via-transparent to-orange-800 opacity-50"></div>
  <div class="absolute inset-0 z-10 bg-black opacity-50"></div>

  <Image src={coverImageUrl} alt={pageName} class="h-60 w-full object-cover lg:h-100" />
</div>
