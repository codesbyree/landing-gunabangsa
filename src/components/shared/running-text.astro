      ))
    }
  </div>
</div>

<script>
  import { gsap } from "@/lib/gsap"

  function initAnimation() {
    const container = document.querySelector("[data-rt]")
    if (!container) return

    const ctx = gsap.context(() => {
      const rtc = container.querySelector("[data-rt-content]")

      gsap.fromTo(
        rtc,
        { x: 0 },
        {
          xPercent: -50,
          ease: "none",
          scrollTrigger: {
            trigger: container,
            start: "top bottom",
            end: "bottom top",
            scrub: true,
          },
        }
      )
    }, container)

    return ctx
  }

  initAnimation()
</script>
