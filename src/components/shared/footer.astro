---
import {
  InstagramIcon,
  Mail01Icon,
  Call02Icon,
} from "@hugeicons/core-free-icons"
import { HugeiconsIcon } from "@hugeicons/react"
---

<div class="hidden md:block md:h-135 xl:h-130"></div>

<footer
  id="footer"
  class="right-0 bottom-0 left-0 z-1 w-full bg-red-900 pt-20 pb-12 md:fixed"
>
  <div class="mx-auto w-full max-w-6xl px-6 xl:px-0 2xl:max-w-7xl">
    <div class="mb-20 grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="mb-8 flex items-center gap-3">
          <img
            src="/assets/images/conference-logo.png"
            alt="logo"
            class="h-14 xl:h-20"
          />
        </div>

        <p class="mb-10 max-w-md leading-relaxed font-medium text-red-100/70">
          The 1st HEALTHMED-IC is an international scientific conference hosted
          by STIKES Guna Bangsa Yogyakarta, Indonesia, bringing together global
          academic and healthcare communities.
        </p>
        <div class="flex gap-3">
          <a
            href="https://www.instagram.com/healthmedic2026/"
            target="_blank"
            class="flex h-10.5 w-10.5 cursor-pointer items-center justify-center rounded-full border border-red-300/60 bg-red-300/30 transition-transform hover:-translate-y-1"
          >
            <HugeiconsIcon
              icon={InstagramIcon}
              className="h-5 w-5 text-red-200"
              fill="currentColor"
              fillOpacity={0.3}
            />
          </a>

          <a
            href="mailto:HEALTHMED-IC@gunabangsa.ac.id"
            target="_blank"
            class="flex h-10.5 w-10.5 cursor-pointer items-center justify-center rounded-full border border-red-300/60 bg-red-300/30 transition-transform hover:-translate-y-1"
          >
            <HugeiconsIcon
              icon={Mail01Icon}
              className="h-5 w-5 text-red-200"
              fill="currentColor"
              fillOpacity={0.3}
            />
          </a>
        </div>
      </div>

      <div>
        <h4 class="mb-6 text-lg font-semibold tracking-tight text-slate-50">
          Quick Actions
        </h4>
        <ul class="space-y-4">
          <li>
            <a href="/" class="text-red-100/70 transition hover:text-red-100">
              Abstract Submission
            </a>
          </li>
          <li>
            <a
              href="/program"
              class="text-red-100/70 transition hover:text-red-100"
            >
              Conference Program
            </a>
          </li>
          <li>
            <a href="/" class="text-red-100/70 transition hover:text-red-100">
              Ethical Guidelines
            </a>
          </li>
          <li>
            <a
              href="/committee"
              class="text-red-100/70 transition hover:text-red-100"
            >
              Committees
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="mb-6 text-lg font-semibold tracking-tight text-slate-50">
          Contact
        </h4>
        <div class="space-y-4">
          <a
            href="tel:+6285727542906"
            class="flex items-center gap-4 text-red-100/70 transition hover:text-red-100"
          >
            <HugeiconsIcon icon={Call02Icon} className="h-4 w-4 text-red-50" />
            <span>Aulia Rahman (Phone)</span>
          </a>
          <a
            href="https://wa.me/6289605367007"
            class="flex items-center gap-4 text-red-100/70 transition hover:text-red-100"
          >
            <HugeiconsIcon icon={Call02Icon} className="h-4 w-4 text-red-50" />
            <span>Fitri Nadifah (WhatsApp)</span>
          </a>
        </div>
      </div>
    </div>

    <div
      class="flex flex-col items-center justify-between border-t border-red-100/30 pt-12 text-xs text-red-100/70 md:flex-row"
    >
      <p>
        © 2026 The 1st HEALTHMED-IC — STIKES Guna Bangsa Yogyakarta. All rights
        reserved.
      </p>
    </div>
  </div>
</footer>
