---
const { title, subtitle, description } = Astro.props
---

<div class="mb-8 grid grid-cols-1 items-end gap-4 md:grid-cols-2 md:gap-10 lg:mb-16">
  <div class="flex flex-col-reverse">
    <h2 data-split-title class="text-xl font-semibold text-red-900 md:text-2xl xl:text-3xl">
      {title}
    </h2>

    <span data-split-body class="text-xs font-medium tracking-wider">{subtitle}</span>
  </div>

  <p data-split-body class="text-gray-600">
    {description}
  </p>
</div>
